{
  "manifest_version": 3,
  "name": "Poker Assistant — PokerSkill + GigaChat",
  "version": "3.3.13",
  "description": "Real-time poker hand analysis with PokerSkill 5-layer system powered by GigaChat LLM",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Poker Assistant — нажмите для включения"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["vision.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://pu-web2.e5t.online/*",
        "*://*.e5t.online/*"
      ],
      "js": ["page_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://pu-web2.e5t.online/*",
        "*://*.e5t.online/*"
      ],
      "js": ["vision.js", "card_parser.js", "content_iframe.js", "manual_input.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["page_bridge.js"],
      "matches": ["*://*/*"]
    }
  ]
}
